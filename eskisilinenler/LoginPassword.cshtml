@{
    ViewData["Title"] = "Şifre Doğrulama";
    Layout = "_AuthLayout";
}

<head>
    <link rel="stylesheet" href="~/css/auth.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>

<body>
    <div class="container">
        <div class="login-card">
            <div class="login-header">
                <h2>Şifre Doğrulama</h2>
                <p>Lütfen 6 haneli şifrenizi giriniz</p>
            </div>

            <div class="password-container">
                <input type="password" class="password-input" placeholder="******" maxlength="6" readonly>
            </div>

            <div class="number-pad">
                <div class="number-button" onclick="addNumber('1')">1</div>
                <div class="number-button" onclick="addNumber('2')">2</div>
                <div class="number-button" onclick="addNumber('3')">3</div>
                <div class="number-button" onclick="addNumber('4')">4</div>
                <div class="number-button" onclick="addNumber('5')">5</div>
                <div class="number-button" onclick="addNumber('6')">6</div>
                <div class="number-button" onclick="addNumber('7')">7</div>
                <div class="number-button" onclick="addNumber('8')">8</div>
                <div class="number-button" onclick="addNumber('9')">9</div>
                <div class="number-button" onclick="removeLastCharacter()">
                    <i class="fas fa-backspace"></i>
                </div>
                <div class="number-button" onclick="addNumber('0')">0</div>
                <div class="number-button" onclick="submitPassword()">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let isSubmitting = false;

        function showNotification(message, type) {
            const existingNotification = document.querySelector('.alert-success, .alert-error');
            if (existingNotification) {
                existingNotification.remove();
            }

            const notification = document.createElement('div');
            notification.className = `alert-${type}`;
            notification.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                <span>${message}</span>
            `;
            document.body.appendChild(notification);
            
            notification.style.opacity = '0';
            notification.style.transform = 'translate(-50%, -20px)';
            
            setTimeout(() => {
                notification.style.opacity = '1';
                notification.style.transform = 'translate(-50%, 0)';
            }, 10);

            setTimeout(() => {
                notification.classList.add('fade-out');
                setTimeout(() => {
                    notification.remove();
                }, 300);
            }, type === 'success' ? 2000 : 3000);
        }

        function addNumber(number) {
            const inputField = document.querySelector('.password-input');
            if (inputField.value.length < 6) {
                inputField.value += number;
                updateSubmitButton();
            }
        }

        function removeLastCharacter() {
            const inputField = document.querySelector('.password-input');
            if (inputField.value.length > 0) {
                inputField.value = inputField.value.slice(0, -1);
                updateSubmitButton();
            }
        }

        function updateSubmitButton() {
            const submitButton = document.querySelector('[onclick="submitPassword()"]');
            const inputField = document.querySelector('.password-input');
            if (inputField.value.length === 6) {
                submitButton.classList.add('active');
            } else {
                submitButton.classList.remove('active');
            }
        }

        function submitPassword() {
            const password = document.querySelector('.password-input').value;
            if (password.length === 6 && !isSubmitting) {
                isSubmitting = true;
                
                const submitButton = document.querySelector('[onclick="submitPassword()"]');
                submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("ValidatePassword", "Account")',
                    data: JSON.stringify({ Sifre: password }),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            setTimeout(() => {
                                window.location.href = response.redirectUrl;
                            }, 500);
                        } else {
                            showNotification(response.message, 'error');
                            document.querySelector('.password-input').value = '';
                            updateSubmitButton();
                        }
                    },
                    error: function() {
                        showNotification('Bir hata oluştu. Lütfen tekrar deneyin.', 'error');
                    },
                    complete: function() {
                        isSubmitting = false;
                        submitButton.innerHTML = '<i class="fas fa-arrow-right"></i>';
                    }
                });
            }
        }

        document.addEventListener('keydown', function(event) {
            if (event.key >= '0' && event.key <= '9') {
                addNumber(event.key);
            } else if (event.key === 'Backspace') {
                removeLastCharacter();
            } else if (event.key === 'Enter') {
                submitPassword();
            }
        });
    </script>
</body>