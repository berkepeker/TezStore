@model IEnumerable<TezStore.Models.SellableItem>

@{
    string? userPhone = ViewBag.UserPhone as string;
    string? userRole = ViewBag.UserRole as string;

    Layout = userRole == "Admin" ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Mağaza";
}

<!-- SADECE ÜRÜN GRİDİ ANA CONTAINER'DA -->
<div class="py-5">
    <div class="row justify-content-center g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card product-card h-100 border-0 shadow-sm position-relative bg-white">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" class="card-img-top product-img" alt="@item.Name" style="height: 180px; object-fit: cover;">
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-center fw-bold text-success">@item.Name</h5>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text flex-grow-1 text-truncate text-secondary">@item.Description</p>
                        }
                        <div class="mt-auto text-center">
                            <span class="badge price-badge mb-2">@item.Price.ToString("C")</span>
                            @if (string.IsNullOrEmpty(userPhone))
                            {
                                <button type="button"
                                        class="btn btn-success w-100 product-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#loginModal">
                                    <i class="bi bi-leaf me-1"></i> Satın Al
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success w-100 product-btn"
                                        onclick="addToCart(@item.Id, '@item.Name', '@item.Price.ToString("F2")', '@item.ImagePath')">
                                    <i class="bi bi-cart-plus me-1"></i> Sepete Ekle
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    const userPhone = '@userPhone';
    const storageKey = userPhone ? `tezStoreCart_${userPhone}` : null;

    let cart = [];
    let cartOpen = false;

    if (storageKey) {
        loadCartFromLocalStorage();
    } else {
        localStorage.clear();
    }

    updateCartPanel();

    document.getElementById("toggleCartBtn")?.addEventListener("click", () => {
        const panel = document.getElementById("cartPanel");
        cartOpen = !cartOpen;

        panel.classList.toggle("cart-open");
        document.getElementById("toggleCartBtn").innerHTML = `<img src="/images/icons/cart.png" class="cart-icon" alt="Sepet" /> ${cartOpen ? "Sepeti Kapat" : "Sepeti Aç"}`;
        updateCartPanel();
    });

    function addToCart(id, name, price, imagePath) {
        price = parseFloat(price);
        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ id, name, price, quantity: 1, imagePath, justAdded: true });
        }
        showNotification(`"${name}" sepete eklendi.`);
        updateCartPanel();
        saveCartToLocalStorage();
    }

    function changeQuantity(id, delta) {
        const index = cart.findIndex(i => i.id === id);
        if (index === -1) return;

        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) {
            const items = document.querySelectorAll(".cart-item");
            items[index]?.classList.add("fade-out");
            setTimeout(() => {
                cart.splice(index, 1);
                updateCartPanel();
                saveCartToLocalStorage();
            }, 300);
        } else {
            updateCartPanel();
            saveCartToLocalStorage();
        }
    }

    function updateCartPanel() {
        const container = document.getElementById("cartItemsContainer");
        const totalEl = document.getElementById("cartTotalAmount");
        // const emptyMsg = document.getElementById("emptyCartMsg");

        if (cart.length === 0) {
            container.innerHTML = "";
            totalEl.innerText = "0.00 ₺";
            return;
        }
        let total = 0;
        container.innerHTML = "";
        cart.forEach((item, index) => {
            const itemTotal = (item.price * item.quantity).toFixed(2);
            total += parseFloat(itemTotal);
            const wrapper = document.createElement("div");
            wrapper.className = "cart-item cart-item-transparent";
            if (item.justAdded) {
                wrapper.classList.add("cart-item-animate-in");
                wrapper.addEventListener("animationend", function() {
                    wrapper.classList.remove("cart-item-animate-in");
                    delete item.justAdded;
                });
            }
            wrapper.innerHTML = `
                <img src="${item.imagePath}" class="rounded" style="width: 80px; height: 80px; object-fit: cover; margin-right: 10px;">
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold text-truncate" style="max-width: 200px; color:#16a34a;">${item.name}</div>
                    <div class="text-muted small">${item.price.toFixed(2)} ₺ x ${item.quantity} = ${itemTotal} ₺</div>
                    <div class="quantity-group mt-1">
                        <button onclick="changeQuantity(${item.id}, -1)">−</button>
                        <span class="quantity-number">${item.quantity}</span>
                        <button onclick="changeQuantity(${item.id}, 1)">+</button>
                    </div>
                </div>
            `;
            container.appendChild(wrapper);
        });
        totalEl.innerText = total.toFixed(2) + " ₺";
    }

    function clearCart() {
        const items = document.querySelectorAll(".cart-item");
        items.forEach((el, i) => setTimeout(() => el.classList.add("fade-out"), i * 50));
        setTimeout(() => {
            cart = [];
            updateCartPanel();
            saveCartToLocalStorage();
            showNotification("Sepet boşaltıldı.", "info");
        }, items.length * 50 + 300);
    }

    function completePurchase() {
        if (cart.length === 0) return;
        const expanded = cart.flatMap(item => Array(item.quantity).fill(item.id));
        fetch("/Store/PurchaseCart", {
            method: "POST",
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(expanded)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message);
                // Fade-out animasyonu uygula
                const items = document.querySelectorAll(".cart-item");
                items.forEach((el, i) => setTimeout(() => el.classList.add("fade-out"), i * 50));
                setTimeout(() => {
                    cart = [];
                    updateCartPanel();
                    saveCartToLocalStorage();
                    // ✅ Bakiye güncelleme
                    if (data.newBalance !== undefined) {
                        document.getElementById("balanceAmount").innerText = parseFloat(data.newBalance).toLocaleString('tr-TR', {
                            style: 'currency',
                            currency: 'TRY'
                        });
                    }
                }, items.length * 50 + 300);
            } else {
                showNotification(data.message, "danger");
            }
        });
    }


    function saveCartToLocalStorage() {
        if (storageKey)
            localStorage.setItem(storageKey, JSON.stringify(cart));
    }

    function loadCartFromLocalStorage() {
        const saved = localStorage.getItem(storageKey);
        if (saved) {
            try {
                cart = JSON.parse(saved);
            } catch {
                cart = [];
            }
        }
    }


    
</script>
}
