@model TezStore.Models.SellableItem

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<h2 class="mb-4">
    <img src="~/images/icons/add.png" class="add-icon" alt="Ekle" /> Yeni Ürün Ekle
</h2>

<form id="addItemForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Ürün Adı</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Fiyat</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Ürün Görseli</label>
        <input type="file" name="imageFile" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Ekle</button>
    <a href="@Url.Action("Items", "Admin")" class="btn btn-secondary">Geri</a>
</form>

@section Scripts {
<script>
    document.getElementById("addItemForm").addEventListener("submit", function (e) {
        e.preventDefault();
        const formData = new FormData(this);

        fetch("/Admin/AddItem", {
            method: "POST",
            body: formData
        })
        .then(res => res.ok ? res.text() : Promise.reject())
        .then(() => {
            showNotification("Ürün başarıyla eklendi.", "success");
            setTimeout(() => window.location.href = "/Admin/Items", 1500);
        })
        .catch(() => {
            showNotification("Ürün eklenemedi.", "danger");
        });
    });
</script>
}

<style>
    .add-icon {
        width: 50px;
        height: 50px;
        object-fit: contain;
        margin-right: 8px;
    }
</style>
